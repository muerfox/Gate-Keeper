# Copy to .env and fill in real values. Never commit the real .env file.
# See README.md "Quick start" for how to generate the signing/encryption keys.

POSTGRES_PASSWORD=changeme_use_a_real_password

# Output of: generateEd25519KeyMaterial() from @gatekeeper/crypto
GATEKEEPER_SIGNING_KEY=

# Output of: generateEncryptionKey() from @gatekeeper/crypto
GATEKEEPER_ENCRYPTION_KEY=

# fail_open | fail_closed — see docs/ARCHITECTURE.md §Failure Modes
GATEKEEPER_REDIS_FAILURE_POLICY=fail_closed
GATEKEEPER_DB_FAILURE_POLICY=fail_closed

# Comma-separated list of origins allowed to call admin-plane endpoints
# from a browser (the dashboard). Leave empty to allow any origin for the
# public verification endpoints (see docs/SECURITY.md — CORS is not the
# trust boundary for those).
GATEKEEPER_CORS_ORIGINS=http://localhost:5173
