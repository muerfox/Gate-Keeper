# Optional config for docker-compose.test.yml (the standalone smoke-test
# stack — see docs/TESTING.md). This file is NOT required — the stack
# self-configures on `docker compose up` with no setup step (it generates
# its own signing/encryption keys inside a one-shot "keygen" container).
# Copy this to .env.test only if you want to override the Postgres
# password used by the throwaway test database.

POSTGRES_PASSWORD=gatekeeper_test_only
