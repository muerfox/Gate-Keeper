# Config for docker-compose.test.yml (the standalone smoke-test stack —
# see docs/TESTING.md). Copy to .env.test and fill in the two keys.
# This is a throwaway stack; reuse the same values as .env.example if you
# like, or generate fresh ones — either is fine.

POSTGRES_PASSWORD=gatekeeper_test_only

# Output of: generateEd25519KeyMaterial() from @gatekeeper/crypto
GATEKEEPER_SIGNING_KEY=

# Output of: generateEncryptionKey() from @gatekeeper/crypto
GATEKEEPER_ENCRYPTION_KEY=
